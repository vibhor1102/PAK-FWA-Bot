# Runtime profile: local, testing, or production.
BOT_RUNTIME=local

# Required: Discord bot token from the Discord Developer Portal > Bot > Token.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional but recommended while testing: your Discord server/guild ID.
# Guild commands update almost instantly; global commands can take up to about an hour.
DISCORD_GUILD_ID=replace-with-your-test-server-id

# Optional PostgreSQL connection string. Use a Supabase pooler URI in production and your local or testing URI here.
DATABASE_URL=

# Optional Clash of Clans API setup for /clanreport.
# coc.py can create and refresh API keys automatically if you provide your Supercell developer portal email/password.
COC_EMAIL=
COC_PASSWORD=
# Optional fallback if you already have API tokens created manually. Comma-separate multiple tokens.
COC_TOKENS=
# Optional tuning for how many API keys coc.py may manage and how they are labeled.
# The code accepts COC_KEY_NAME or COC_KEY_NAMES; the singular form matches the current Render setup.
COC_KEY_NAME=PAK FWA Bot
COC_KEY_COUNT=1
COC_KEY_SCOPES=clash
COC_THROTTLE_LIMIT=30

# Optional proactive war monitor tuning.
# CoC API is polled on this interval. FWA Stats and points.fwafarm are only checked
# during the configured early-war window after CoC reports the match.
WAR_MONITOR_INTERVAL_SECONDS=300
FWA_EXTERNAL_LOOKUP_START_HOURS=2
FWA_EXTERNAL_LOOKUP_END_HOURS=4
MANUAL_EXTERNAL_LOOKUP_TAG_COOLDOWN_SECONDS=180
AUTOMATIC_EXTERNAL_LOOKUP_TAG_COOLDOWN_SECONDS=900
EXTERNAL_LOOKUP_USER_BURST_PER_MINUTE=3
EXTERNAL_LOOKUP_GUILD_BURST_PER_MINUTE=12

# Render injects PORT automatically. Keep this for local development only if desired.
PORT=3000
