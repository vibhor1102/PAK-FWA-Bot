# Required: Discord bot token from the Discord Developer Portal > Bot > Token.
DISCORD_TOKEN=replace-with-your-bot-token

# Optional but recommended while testing: your Discord server/guild ID.
# Guild commands update almost instantly; global commands can take up to about an hour.
DISCORD_GUILD_ID=replace-with-your-test-server-id

# Render injects PORT automatically. Keep this for local development only if desired.
PORT=3000
